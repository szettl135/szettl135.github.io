---
import { getCollection } from "astro:content";
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import ToolGrid from '../components/ToolGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyTimeline from "../components/JourneyTimeline.astro";

const toolEntries = await getCollection("tools");
const tools = toolEntries.map((e) => e.data);
const items = await getCollection("journey");
---

<BaseLayout>

	<h1>About me</h1>

	<div class="text-container">
		<p>
			Heyo, I'm Sebastian Zettl, a passionate full-stack developer dedicated to crafting seamless and functional web and mobile applications.
		</p>
		<p>
			My background includes extensive experience on both the frontend and backend, enabling me to develop complete solutions from concept to launch. I focus on creating intuitive user interfaces using modern JavaScript and TypeScript, alongside frameworks like React or Angular, complemented by responsive and accessible design principles. On the backend, I leverage technologies such as Node.js or Nest.js and also PHP to build scalable APIs and robust server-side logic, backed by relational databases like MySQL and PostgreSQL to ensure a solid foundation for any application.
		</p>
		<p>
			My technical education also gave me hands-on experience in Java and Python through different tasks and projects, which continues to shape how I approach problem-solving, algorithms, and object-oriented design, even when my day-to-day work is more centered on JavaScript and TypeScript. I also use Kotlin for native Android development and Ionic for hybrid app development, which, together with Java and Kotlin, gives me a broader base to approach problems outside the browser.
		</p>
		<p>
			My toolkit also includes proficiency with Docker, allowing me to streamline development, testing, and deployment processes through containerization.
		</p>
		<p>
			Driven by a curiosity for technology and a commitment to constant improvement, I continuously expand my skill set to embrace new frameworks and methodologies. I enjoy the full development lifecycle and the challenge of turning complex requirements into elegant, working solutions.
		</p>
		<p>
			I'm always eager to take on new projects and collaborate with others to build innovative digital experiences.
		</p>

	</div>

	<div class="journey">
		<h2>My Journey</h2>
		<JourneyTimeline items={items} sort="desc" />
	</div>
	
	<div>
		<h2>Acquired skills</h2>

		<h4>Languages</h4>
		<div class="tool-conatiner">
			<ToolGrid tools={tools} category="Language" />

		</div>

		<h4>Frameworks & Libraries</h4>
		<div class="tool-conatiner">
			<ToolGrid tools={tools} category="Framework" />

		</div>
		
		<h4>Backend & Databases</h4>
			<ToolGrid tools={tools} category="Backend" />
		
		<h4>Tools and Others</h4>
		<ToolGrid tools={tools} category="Others" />
	</div>

	<style>
		.text-container {

		}
	</style>
</BaseLayout>
