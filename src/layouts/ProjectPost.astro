---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';


type Props = CollectionEntry<'project'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, technology, link } = Astro.props;
---

<BaseLayout title={title} description={description}>	
	<article>
		<div class="hero-image">
			{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<div>
					<p class="tag-row">
						{tags.map((tag: string) => (
								<span class="tag">{tag}</span>
						))}
					</p>
				</div>
				<div class="technology-row">
					Technology:
					{technology?.map((tech: string) => (
						<span class="technology">{tech}</span>
					))}
				</div>

					{
						link && (
							<a href={link}>{link}</a>
						)
					}
				<hr />
			</div>
			<slot />
		</div>
	</article>

	<style>
		main {
			width: calc(100% - 2em);
			max-width: 100%;
			margin: 0;
		}
		.hero-image {
			width: 100%;
		}
		.hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 12px;
			box-shadow: var(--box-shadow);
		}
		.prose {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 1em;
			color: rgb(var(--gray-dark));
		}
		.title {
			margin-bottom: 1em;
			padding: 1em 0;
			text-align: center;
			line-height: 1;
		}
		.title h1 {
			margin: 0 0 0.5em 0;
		}
		.date {
			margin-bottom: 0.5em;
			color: rgb(var(--gray));
		}
		.last-updated-on {
			font-style: italic;
		}

		.technology-row {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			justify-content: center;
			margin-bottom: 1rem;
		}

		.technology {
			/* padding: 0.35rem 0.75rem; */
			/* border: 1px solid rgb(var(--gray-light)); */
			border-radius: 999px;
			/* font-size: 0.85rem; */
			font-weight: 500;
			background: transparent;
			color: rgb(var(--gray-dark));
		}

		.technology:not(:last-child)::after {
			content: ', ';
		}

		.prose :global(.video-wrapper) {
			width: 100%;
			overflow: hidden;
		}
		.prose :global(.video-wrapper video) {
			width: 100%;
			height: auto;
		}

		/* Für kleine Bilder allgemein */
		.prose :global(.img-small) {
			max-width: 400px;
			display: block;
			margin: 0 auto;
		}

		/* Speziell für Handy-Hochformat-Screenshots */
		.prose :global(.img-portrait) {
			max-height: 600px;
			width: auto;
			display: block;
			/* margin: 0 auto; */
		}

		.prose :global(figure) {
			margin: 2em 0;
			text-align: center;
			display: block;
		}

		.prose :global(figure img) {
			margin: 0 auto;
			display: block;
		}

		.prose :global(figcaption) {
			margin-top: 0.5em;
			font-size: 0.85em;
			color: var(--text-muted);
			font-style: italic;
			display: block;
		}

		/* Kombination: kleines Bild mit Caption */
		.prose :global(figure.img-portrait img) {
			max-height: 600px;
			width: auto;
		}

		.prose :global(.img-row) {
			display: flex;
			gap: 1rem;
			justify-content: center;
		}

		.prose :global(.img-row img) {
			flex: 1;              /* statt fixer width */
    min-width: 0;
			/* width: 48%; */
			object-fit: contain;
			border-radius: 8px;
		}
		
		

		@media (max-width: 720px) {
			.title {
				font-size: medium;
			}
			.prose :global(.img-row) {
				flex-direction: column;
			}

			.prose :global(.img-row img) {
				width: 100%;
			}
		}
	</style>
</BaseLayout>
